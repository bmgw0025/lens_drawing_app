{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lens-drawing:agent-request:1.2",
  "title": "Lens Drawing Agent Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source",
    "user_evidence",
    "requirement_analysis",
    "naming",
    "manufacturing_requirements",
    "execution"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "task_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zmx_path", "sha256"],
      "properties": {
        "zmx_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "user_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["user_message", "attachment", "operator_record"]},
          "content": {"type": "string", "minLength": 1},
          "captured_at": {"type": "string"},
          "source_ref": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "requirement_analysis": {
      "type": "object",
      "required": [
        "user_goal_summary",
        "decisions",
        "evidence_disposition",
        "assumptions",
        "unresolved_questions"
      ],
      "properties": {
        "user_goal_summary": {"type": "string", "minLength": 1},
        "decisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "statement", "evidence_ids"],
                "properties": {
                  "category": {"enum": ["naming", "manufacturing_complete"]},
                  "statement": {"type": "string", "minLength": 1},
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["category", "confirmation_id", "statement", "evidence_ids"],
                "properties": {
                  "category": {"const": "geometry_confirmation"},
                  "confirmation_id": {"type": "string", "minLength": 1},
                  "statement": {"type": "string", "minLength": 1},
                  "evidence_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            ]
          }
        },
        "evidence_disposition": {"type": "object"},
        "assumptions": {"type": "array", "maxItems": 0},
        "unresolved_questions": {"type": "array", "maxItems": 0}
      }
    },
    "naming": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "lens_model", "lens_element_model", "first_production_code", "element_sequence_start", "evidence_ids"],
          "properties": {
            "mode": {"const": "production_sequence"},
            "lens_model": {"type": "string", "minLength": 1, "maxLength": 64},
            "lens_element_model": {"type": "string", "minLength": 1, "maxLength": 64},
            "first_production_code": {"type": "string", "minLength": 1, "maxLength": 20},
            "element_sequence_start": {"type": "integer", "minimum": 1},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "confirm_generated_names", "evidence_ids"],
          "properties": {
            "mode": {"const": "generated"},
            "confirm_generated_names": {"const": true},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "part_name_base", "append_group_suffix", "evidence_ids"],
          "properties": {
            "mode": {"const": "base_name"},
            "part_name_base": {"type": "string", "minLength": 1, "maxLength": 15},
            "part_no_base": {"type": "string", "maxLength": 20},
            "append_group_suffix": {"type": "boolean"},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "groups", "evidence_ids"],
          "properties": {
            "mode": {"const": "per_group"},
            "groups": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["PartName"],
                "properties": {
                  "PartName": {"type": "string", "minLength": 1, "maxLength": 15},
                  "PartNo": {"type": "string", "maxLength": 20}
                }
              }
            },
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "manufacturing_requirements": {
      "type": "object",
      "required": [
        "approval_status",
        "approve_effective_manufacturing_requirements",
        "approval_source",
        "policy_id",
        "policy_sha256",
        "approved_by",
        "approved_at",
        "source",
        "reason",
        "evidence_ids",
        "field_evidence",
        "global_overrides",
        "group_overrides",
        "page_overrides"
      ],
      "properties": {
        "approval_status": {"const": "approved"},
        "approve_effective_manufacturing_requirements": {"const": true},
        "approval_source": {"const": "deployment_policy"},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "source": {"const": "deployment_policy"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "field_evidence": {"type": "object"},
        "global_overrides": {"type": "object"},
        "group_overrides": {"type": "object"},
        "page_overrides": {"type": "object"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_root", "automated_pdf_validation", "visual_review"],
      "properties": {
        "mode": {"enum": ["production", "test"]},
        "renderer_root": {"type": "string", "minLength": 1},
        "automated_pdf_validation": {"const": true},
        "visual_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "mode"],
          "properties": {
            "required": {"const": true},
            "mode": {"enum": ["vision_agent", "human_operator"]}
          }
        }
      }
    }
  }
}
