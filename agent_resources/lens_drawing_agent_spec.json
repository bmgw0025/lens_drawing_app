{
  "agent_interface": {
    "commands": [
      "capabilities",
      "spec",
      "create",
      "submit",
      "validate",
      "run",
      "status",
      "review"
    ],
    "installed_entrypoint": "LensDrawing.exe --agent --output-json <path> <command>",
    "output_contract": {
      "exit_codes": {
        "0": "command completed and its requested gate passed",
        "1": "argument, resource or execution error",
        "2": "command completed but geometry, validation, review or release gate is not passed"
      },
      "format": "UTF-8 JSON envelope",
      "required_flag_for_windowed_install": "--output-json <path>",
      "top_level_fields": [
        "ok",
        "command",
        "exit_code",
        "interface_version",
        "result or error"
      ]
    },
    "request_schema_version": "1.1",
    "source_entrypoint": "python agent_cli.py <command>",
    "task_schema_version": "1.0",
    "version": "4.0.0"
  },
  "agent_judgment_required": [
    "translate user language into evidence-backed naming and process fields",
    "ask only unresolved naming, complete manufacturing and exact geometry review questions",
    "explain blocked or ambiguous geometry without overriding it",
    "disclose high-confidence warnings and excluded prism groups at delivery",
    "prepare the task for an authorized human visual review without recording the decision"
  ],
  "application": {
    "display_name": "Lens Drawing",
    "name": "LensDrawing",
    "version": "4.0",
    "version_full": "4.0.0"
  },
  "evidence": {
    "attachments_require_sha256": true,
    "every_evidence_item_requires_disposition": true,
    "every_override_requires_field_evidence": true,
    "production_kinds": [
      "user_message",
      "attachment"
    ],
    "test_only_kinds": [
      "operator_record"
    ]
  },
  "geometry_policy": {
    "agent_mutable": false,
    "authoritative_input": ".zmx",
    "fields": [
      "Glass",
      "T",
      "R",
      "MD",
      "AD_left",
      "AD_right"
    ],
    "geometry_contract": "lenses[] is authoritative for per-lens Glass/T/R/MD/AD_left/AD_right; row is a legacy compatibility view and may contain null at a virtual interface whose two AD values differ",
    "medium_confidence_requires_exact_acknowledgement": true,
    "prism_exclusion_rule": "exclude a single H-K9L element with two plane surfaces from drawing, retain deterministic evidence, and disclose the exclusion at delivery",
    "screenshot_policy": "screenshots may support identification or user evidence but cannot enter the accurate automatic geometry path; require ZMX or a separately confirmed manual route",
    "semi_diameter_rule": "AD and MD are full diameters; never map AD to MD",
    "source": "read-only native ZOS-API extraction from one ZMX",
    "topology_and_dimension_review_are_separate": true,
    "virtual_interface_effect": "collapse the duplicated LDE surfaces into one logical R boundary, preserve side-specific AD and MEMA evidence for the adjacent lenses, and do not split the cemented lens group",
    "virtual_interface_rule": "zero-thickness non-glass gaps are cemented only when duplicated surface type/radius match and no tilt/decenter exists"
  },
  "human_operator_judgment_required": [
    "visually review every rendered PDF page",
    "record passed or failed through the review command"
  ],
  "installed_dependencies": {
    "bundled": [
      "Lens Drawing renderer",
      "Agent CLI",
      "PDF validation runtime",
      "Lens Drawing Agent Skill"
    ],
    "external": [
      "Windows x64",
      "Ansys Zemax OpticStudio 2022 R2.01 with valid license for ZMX import"
    ]
  },
  "manual_application": {
    "entrypoint": "LensDrawing.exe",
    "modules": [
      "draw",
      "batch",
      "settings"
    ],
    "preserved": true
  },
  "naming": {
    "modes": [
      "production_sequence",
      "generated",
      "base_name",
      "per_group"
    ],
    "production_sequence": {
      "excluded_groups_consume_sequence_numbers": false,
      "first_production_code": "PartNo for the first drawable group; trailing digits increment with preserved width",
      "lens_element_model": "MfrPdfFolder and PartName prefix; PartName uses -1, -2, ... in drawable surface order",
      "lens_model": "SavePdfFolder for every drawable group"
    },
    "renderer_text": "ASCII letters, digits, dot, underscore and hyphen"
  },
  "override_precedence": [
    "renderer_defaults",
    "global_overrides",
    "group_overrides",
    "page_overrides"
  ],
  "persistent_artifacts": [
    "task_state.json",
    "AGENT_PROTOCOL.md",
    "agent_request.schema.json",
    "lens_drawing_agent_spec.json",
    "AGENT_HANDOFF.md",
    "source_analysis/",
    "agent_request.json",
    "request_versions/",
    "request_validation.json",
    "result/",
    "result/manufacturing_requirements_delivery.json",
    "result/manufacturing_requirements_summary.md",
    "human_visual_review.json",
    "delivery_manifest.json"
  ],
  "process_default_policy": {
