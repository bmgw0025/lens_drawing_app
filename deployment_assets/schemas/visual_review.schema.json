{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lensbot://schemas/visual-review-1",
  "title": "LensBot vision review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "review_kind",
    "model",
    "prompt_version",
    "duration_ms",
    "summary",
    "issues",
    "uncertainties",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "review_kind": {
      "const": "vision_agent"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_sheets",
        "pdfs"
      ],
      "properties": {
        "contact_sheets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "pdfs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page",
        "severity",
        "category",
        "description"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor"
          ]
        },
        "category": {
          "enum": [
            "blank",
            "crop",
            "overlap",
            "missing_label",
            "unreadable",
            "page_order",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          },
          "uncertainties": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "uncertainties": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ]
}

